[Unit]
Description=RustDesk integration relay server (official 1.1.16)
Wants=network-online.target
Requires=rustdesk-integration-hbbs.service
After=network-online.target rustdesk-integration-hbbs.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
User=rustdesk-integration
Group=rustdesk-integration
WorkingDirectory=/var/lib/rustdesk-integration/server
ExecStartPre=/opt/rustdesk-integration/server/1.1.16/check-key-state.sh hbbr
ExecStart=/opt/rustdesk-integration/server/1.1.16/hbbr -p 21117 -k _
Environment=RUST_LOG=info
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rustdesk-integration/server
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
